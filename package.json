{
  "name": "hearing-union",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/local.ts",
    "build": "tsc --noEmit && esbuild mcp-ui/lectures.ts --bundle --format=esm --outfile=.local/lectures.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "check:docs": "python3 scripts/check_okf.py"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/server": "2.3.1",
    "@openai/mcp-extensions": "0.2.1",
    "zod": "4.6.7"
  }
}
