{
  "name": "hearing-union",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/local.ts",
    "build": "tsc --noEmit && tsx scripts/build.ts && wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "check:docs": "python3 scripts/check_okf.py",
    "import:knowledge": "tsx scripts/import-knowledge.ts",
    "backup": "tsx scripts/backup.ts",
    "events:drain": "tsx scripts/drain-events.ts",
    "pack": "tsx scripts/pack.ts",
    "dev:worker": "npm run build && wrangler dev --local",
    "db:local": "tsx scripts/migrations.ts && wrangler d1 migrations apply DB --local",
    "check:deployment": "tsx scripts/check-deployment.ts",
    "smoke:worker": "tsx scripts/smoke-worker.ts",
    "db:generate": "tsx scripts/migrations.ts --write",
    "check:package": "tsx scripts/check-package.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.2-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/server": "2.3.1",
    "@openai/mcp-extensions": "0.2.1",
    "zod": "4.6.7"
  }
}
