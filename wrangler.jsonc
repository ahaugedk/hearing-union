{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hearing-union",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{"binding": "DB", "database_name": "hearing-union", "migrations_dir": "db/migrations"}],
  "triggers": {"crons": ["* * * * *"]},
  "rules": [{"type": "Text", "globs": ["**/*.js.txt"], "fallthrough": true}]
}
